# checkin configuration. Copy to ~/.config/checkin/config.env and edit.

# Base daily-log folder the habit log is written into. Any directory of
# dated markdown notes works — an Obsidian vault, a plain notes dir, etc.
NOTES_DIR="$HOME/notes"

# Subdirectory under NOTES_DIR holding per-day folders.
DAILY_SUBDIR="10-Daily"

# Name of the per-day log file. The frontmatter `type:` and the `#` heading are
# derived from it (e.g. hourly-log.md -> type: hourly-log, "# Hourly log").
LOG_FILENAME="habit-log.md"
